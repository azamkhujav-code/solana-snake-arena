{
  "name": "@arena/solana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Solana SDK: RPC pool, transaction builder, instruction encoding, signature verification and settlement service.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./phantom": {
      "types": "./dist/phantom.d.ts",
      "import": "./dist/phantom.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "sync:idl": "tsx scripts/sync-idl.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arena/eslint-config": "workspace:*",
    "@arena/typescript-config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.39.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
