{
  "name": "@arena/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "BullMQ worker driving the ten-minute match cycle for every room tier.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env -- tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@arena/db": "workspace:*",
    "@arena/env": "workspace:*",
    "@arena/lobby": "workspace:*",
    "@arena/logger": "workspace:*",
    "@arena/redis": "workspace:*",
    "@arena/solana": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "bullmq": "^6.0.0",
    "close-with-grace": "^2.5.0",
    "ioredis": "^5.11.1",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arena/eslint-config": "workspace:*",
    "@arena/typescript-config": "workspace:*",
    "@types/node": "^22.10.5",
    "bs58": "^6.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1",
    "tweetnacl": "^1.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
