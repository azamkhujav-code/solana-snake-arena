{
  "name": "@arena/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Next.js 15 App Router client. PixiJS renderer, Zustand state, TanStack Query.",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --turbopack --port 3000",
    "build": "dotenv -e ../../.env -- next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true next build",
    "clean": "rimraf .next .turbo out *.tsbuildinfo"
  },
  "dependencies": {
    "@arena/game-core": "workspace:*",
    "@arena/protocol": "workspace:*",
    "@arena/solana": "workspace:*",
    "@arena/ui": "workspace:*",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.101.4",
    "bs58": "^6.0.0",
    "next": "^15.5.22",
    "pixi.js": "^8.19.0",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@arena/env": "workspace:*",
    "@arena/eslint-config": "workspace:*",
    "@arena/typescript-config": "workspace:*",
    "@next/bundle-analyzer": "^15.5.22",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
