{
  "name": "@arena/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Authoritative simulation + Socket.IO fan-out. Stateful, sharded by room.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env -- tsx watch --clear-screen=false src/index.ts",
    "start": "node --max-old-space-size=2048 dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@arena/env": "workspace:*",
    "@arena/game-core": "workspace:*",
    "@arena/logger": "workspace:*",
    "@arena/protocol": "workspace:*",
    "@arena/redis": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.11.0",
    "fastify-plugin": "^6.0.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arena/eslint-config": "workspace:*",
    "@arena/typescript-config": "workspace:*",
    "@types/node": "^22.10.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
