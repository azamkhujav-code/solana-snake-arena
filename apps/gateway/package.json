{
  "name": "@arena/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Stateless REST API: wallet auth, profiles, leaderboards, settlement.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env -- tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@arena/db": "workspace:*",
    "@arena/env": "workspace:*",
    "@arena/logger": "workspace:*",
    "@arena/protocol": "workspace:*",
    "@arena/redis": "workspace:*",
    "@arena/solana": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/under-pressure": "^9.1.0",
    "@solana/web3.js": "^1.98.4",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.11.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arena/eslint-config": "workspace:*",
    "@arena/typescript-config": "workspace:*",
    "@types/node": "^22.10.5",
    "bs58": "^6.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "tweetnacl": "^1.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
