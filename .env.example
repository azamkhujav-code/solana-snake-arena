# =============================================================================
# Slither Arena — environment template
#
# Copy to .env and fill in. Every variable is validated by Zod at service boot
# (packages/env); a missing or malformed value fails fast with a list of every
# problem rather than surfacing as undefined at request time.
#
#   cp .env.example .env
#   pnpm env:check
# =============================================================================

# ---- Shared -----------------------------------------------------------------
# NODE_ENV is deliberately NOT set here. The runtime owns it: `next build` sets
# production, `next dev` sets development, and the container platform sets it
# for the services. Putting it in .env leaks development mode into production
# builds — Next.js fails the build outright when that happens.
LOG_LEVEL=info
# Human-readable logs locally; must be false in production so the log pipeline
# receives newline-delimited JSON.
LOG_PRETTY=true
DEPLOY_REGION=local
GIT_SHA=dev

# ---- Postgres ---------------------------------------------------------------
# Runtime traffic goes through PgBouncer (port 6432).
DATABASE_URL=postgresql://arena:arena@localhost:6432/arena?pgbouncer=true&connection_limit=10
# Migrations and introspection must bypass the pooler.
DIRECT_DATABASE_URL=postgresql://arena:arena@localhost:5432/arena
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Comma-separated host:port list. Leave empty for single-node; set it and the
# client switches to Cluster mode automatically.
# REDIS_CLUSTER_NODES=redis-0:6379,redis-1:6379,redis-2:6379
REDIS_TLS=false
REDIS_KEY_PREFIX=arena:

# ---- Auth -------------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_NONCE_TTL_SECONDS=300
# Must match the domain shown in the Phantom signing prompt.
AUTH_DOMAIN=localhost:3000

# Hard ceiling on concurrent sockets per process. A backstop, not a policy —
# the load balancer should shed load long before this.
MAX_CONNECTIONS=10000

# ---- HTTP -------------------------------------------------------------------
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=15000
# Only true when actually behind a proxy/ALB; otherwise clients can spoof their
# IP via X-Forwarded-For and bypass rate limits.
TRUST_PROXY=true
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# ---- Gateway ----------------------------------------------------------------
# PORT is per-service; set it in each service's own environment.
# PORT=4000
MATCHMAKER_INTERNAL_URL=http://localhost:4002
# Where the matchmaker reaches the gateway to reserve entry fees.
GATEWAY_INTERNAL_URL=http://localhost:4000

# ---- Realtime ---------------------------------------------------------------
# PORT=4001
# Stable per-process identity. In Kubernetes this comes from the pod name.
NODE_ID=realtime-local-1
# Address clients use to reach THIS pod specifically, not a load-balanced name.
ADVERTISE_URL=http://localhost:4001
TICK_RATE_HZ=30
SNAPSHOT_RATE_HZ=15
MAX_ROOMS_PER_NODE=40
MAX_PLAYERS_PER_ROOM=120
AOI_CELL_SIZE=512
MAX_INPUTS_PER_SECOND=60
RECONNECT_GRACE_SECONDS=15
DRAIN_TIMEOUT_SECONDS=30

# ---- Matchmaker -------------------------------------------------------------
# PORT=4002
NODE_HEARTBEAT_TTL_SECONDS=15
ROOM_TARGET_FILL_RATIO=0.8
# least-loaded | best-fit | region-affinity
PLACEMENT_STRATEGY=best-fit

# ---- Solana -----------------------------------------------------------------
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
# Replace after `anchor deploy`; `anchor keys list` prints the deployed id.
ARENA_PROGRAM_ID=Arena111111111111111111111111111111111111111

# ---- Observability ----------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9464
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=

# =============================================================================
# Frontend (apps/web)
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so
# they are public by definition — never put a secret here, and remember that
# changing one requires a rebuild, not just a restart.
# =============================================================================
NEXT_PUBLIC_APP_NAME=Slither Arena
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_MATCHMAKER_URL=http://localhost:4002
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_ARENA_PROGRAM_ID=Arena111111111111111111111111111111111111111
NEXT_PUBLIC_ENABLE_DEVTOOLS=true
# NEXT_PUBLIC_SENTRY_DSN=

# ---- Worker (BullMQ match cycle) --------------------------------------------
# Stage jobs processed concurrently.
WORKER_CONCURRENCY=5
# Set to false on extra worker replicas: many consumers, exactly one scheduler.
WORKER_SCHEDULER_ENABLED=true
# Base58 secret key for the settlement authority, if this worker settles matches.
# SETTLEMENT_AUTHORITY_SECRET=
