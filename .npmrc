# Keep the dependency graph strict so packages must declare what they import.
# This is what stops a workspace package from silently relying on a hoisted dep.
strict-peer-dependencies=false
auto-install-peers=true
shamefully-hoist=false

# Prisma + esbuild + sharp need lifecycle scripts to fetch native binaries.
enable-pre-post-scripts=true

# Reproducible CI installs.
resolution-mode=highest
save-exact=false
engine-strict=true

# Prevent accidental publishing of private workspace packages.
access=restricted
